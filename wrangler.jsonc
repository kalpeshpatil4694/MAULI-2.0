{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mauli-2-0",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "secrets": {
    "required": [
      "GITHUB_TOKEN",
      "CLOUDFLARE_API_TOKEN"
    ]
  },
  "vars": {
    "APP_NAME": "MAULI 2.0",
    "ENVIRONMENT": "production",
    "MAULI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mauli2-production",
      "database_id": "28a660a3-0a0d-438c-ad8d-e52f0658c655",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "mauli2-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAULI_PROJECT_EXECUTOR",
        "class_name": "MauliProjectExecutionCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-execution-coordinator",
      "new_sqlite_classes": [
        "MauliProjectExecutionCoordinator"
      ]
    }
  ]
}
