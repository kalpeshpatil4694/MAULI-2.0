          "summary": "Secure payment gateway integration for e-commerce platform",
          "files": [
            {
              "path": "index.html",
              "content": "<!DOCTYPE html><html><head><title>Payment Gateway</title></head><body><h1>Secure Payment Gateway</h1><form id='payment-form'><label for='card-number'>Card Number:</label><input type='text' id='card-number' name='card-number'><br><br><label for='expiration-date'>Expiration Date:</label><input type='text' id='expiration-date' name='expiration-date'><br><br><label for='cvv'>CVV:</label><input type='text' id='cvv' name='cvv'><br><br><button id='pay-button'>Pay</button></form><script src='script.js'></script></body></html>"
            },
            {
              "path": "script.js",
              "content": "const form = document.getElementById('payment-form');form.addEventListener('submit', (e) => {e.preventDefault();const cardNumber = document.getElementById('card-number').value;const expirationDate = document.getElementById('expiration-date').value;const cvv = document.getElementById('cvv').value;// Send payment information to server for processingfetch('/pay', {method: 'POST',headers: { 'Content-Type': 'application/json' },body: JSON.stringify({ cardNumber, expirationDate, cvv })}).then((response) => response.json()).then((data) => console.log(data)).catch((error) => console.error(error));});"
            },
            {
              "path": "styles.css",
              "content": "body {font-family: Arial, sans-serif;}#payment-form {width: 50%;margin: 40px auto;padding: 20px;border: 1px solid #ccc;border-radius: 10px;box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);}"
            }
          ],
          "tests": [
            "Test payment form submission with valid payment information",
            "Test payment form submission with invalid payment information",
            "Test payment form submission with missing payment information"
