          "summary": "Location Hide Application",
          "files": [
            {
              "path": "server.js",
              "content": "const express = require('express');\nconst app = express();\nconst port = 3000;\nconst cors = require('cors');\nconst mongoose = require('mongoose');\n\napp.use(cors());\napp.use(express.json());\n\nmongoose.connect('mongodb://localhost/locationhide', { useNewUrlParser: true, useUnifiedTopology: true });\n\nconst locationSchema = new mongoose.Schema({\n  latitude: String,\n  longitude: String,\n  hidden: Boolean\n});\n\nconst Location = mongoose.model('Location', locationSchema);\n\napp.post('/locations', (req, res) => {\n  const location = new Location(req.body);\n  location.save((err) => {\n    if (err) {\n      res.status(500).send({ message: 'Error saving location' });\n    } else {\n      res.send({ message: 'Location saved successfully' });\n    }\n  });\n});\n\napp.get('/locations', (req, res) => {\n  Location.find({ hidden: false }, (err, locations) => {\n    if (err) {\n      res.status(500).send({ message: 'Error fetching locations' });\n    } else {\n      res.send(locations);\n    }\n  });\n});\n\napp.put('/locations/:id', (req, res) => {\n  Location.findByIdAndUpdate(req.params.id, { hidden: true }, (err) => {\n    if (err) {\n      res.status(500).send({ message: 'Error hiding location' });\n    } else {\n      res.send({ message: 'Location hidden successfully' });\n    }\n  });\n});\n\napp.use((err, req, res, next) => {\n  res.status(500).send({ message: 'Internal Server Error' });\n});\n\napp.listen(port, () => {\n  console.log(`Server started on port ${port}`);\n});\n"
            },
