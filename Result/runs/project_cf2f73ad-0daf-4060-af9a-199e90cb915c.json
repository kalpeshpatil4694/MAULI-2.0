          "files": [
            {
              "path": "server.js",
              "content": "const express = require('express');\nconst app = express();\nconst port = 3000;\nconst mongoose = require('mongoose');\nconst Location = require('./models/Location');\n\napp.use(express.json());\n\nmongoose.connect('mongodb://localhost/location-hide', { useNewUrlParser: true, useUnifiedTopology: true });\n\napp.post('/locations', async (req, res) => {\n    try {\n        const location = new Location(req.body);\n        await location.save();\n        res.status(201).send(location);\n    } catch (err) {\n        res.status(400).send(err);\n    }\n});\n\napp.get('/locations', async (req, res) => {\n    try {\n        const locations = await Location.find().select('-coordinates');\n        res.send(locations);\n    } catch (err) {\n        res.status(500).send(err);\n    }\n});\n\napp.get('/locations/:id', async (req, res) => {\n    try {\n        const location = await Location.findById(req.params.id).select('-coordinates');\n        if (!location) return res.status(404).send('Location not found');\n        res.send(location);\n    } catch (err) {\n        res.status(500).send(err);\n    }\n});\n\napp.listen(port, () => {\n    console.log(`Server started on port ${port}`);\n});\n"
            },
            {
              "path": "package.json",
              "content": "{\n  \"name\": \"location-hide\",\n  \"version\": \"1.0.0\",\n  \"description\": \"\",\n  \"main\": \"server.js\",\n  \"scripts\": {\n    \"start\": \"node server.js\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"dependencies\": {\n    \"express\": \"^4.17.1\",\n    \"mongoose\": \"^6.2.10\"\n  }\n}\n"
            },
            {
              "path": "models/Location.js",
              "content": "const mongoose = require('mongoose');\n\nconst locationSchema = new mongoose.Schema({\n    name: String,\n    description: String,\n    coordinates: {\n        type: [Number],\n        index: '2dsphere'\n    }\n});\n\nconst Location = mongoose.model('Location', locationSchema);\n\nmodule.exports = Location;\n"
            },
