          "files": [
            {
              "path": "converter.py",
              "content": "from flask import Flask, request, jsonify\n\napp = Flask(__name__)\n\n# Define conversion factors\nconversion_factors = {\n    'length': {'meter': 1, 'centimeter': 100, 'kilometer': 0.001},\n    'weight': {'gram': 1, 'kilogram': 0.001, 'ton': 0.000001}\n}\n\n# Define conversion functions\ndef convert_length(value, from_unit, to_unit):\n    if from_unit not in conversion_factors['length'] or to_unit not in conversion_factors['length']:\n        return 'Invalid unit'\n    return value * conversion_factors['length'][from_unit] / conversion_factors['length'][to_unit]\n\ndef convert_weight(value, from_unit, to_unit):\n    if from_unit not in conversion_factors['weight'] or to_unit not in conversion_factors['weight']:\n        return 'Invalid unit'\n    return value * conversion_factors['weight'][from_unit] / conversion_factors['weight'][to_unit]\n\n# Define API endpoints\n@app.route('/convert', methods=['POST'])\ndef convert):\n    data = request.get_json()\n    if data['type'] == 'length':\n        result = convert_length(data['value'], data['from_unit'], data['to_unit'])\n    elif data['type'] == 'weight':\n        result = convert_weight(data['value'], data['from_unit'], data['to_unit'])\n    else:\n        return jsonify({'error': 'Invalid conversion type'}), 400\n    return jsonify({'result': result}), 200\n\nif __name__ == '__main__':\n    app.run(debug=True)"
